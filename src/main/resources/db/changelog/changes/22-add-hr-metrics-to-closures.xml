<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="25-add-hr-metrics-to-closures" author="rafael">
        <addColumn tableName="monthly_closures">
            <column name="unjustified_absences" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="dsr_discount_hours" type="DOUBLE PRECISION" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>